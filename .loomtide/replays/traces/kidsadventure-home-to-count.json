{
  "schemaVersion": "0.1",
  "id": "kidsadventure-home-to-count",
  "title": "KidsAdventure home tile opens Count The Fruits",
  "intent": "Prove the generic feel trace-replay adapter can run a real uGUI replay trace on KidsAdventure.",
  "start": {
    "scene": "Assets/Scenes/KidsAdventure.unity",
    "reset": "scene-load"
  },
  "input": {
    "backend": "ui-events"
  },
  "segments": [
    {
      "id": "open-count-the-fruits",
      "actions": [
        {
          "do": "tap",
          "locator": {
            "path": "/Canvas/Tiles/Tile_CountTheFruits"
          }
        }
      ],
      "anchors": [
        {
          "id": "count-start-visible",
          "kind": "ui-visible",
          "locator": {
            "path": "/HUD/StartScreen/StartButton"
          },
          "timeoutMs": 5000
        }
      ],
      "captures": [
        {
          "id": "count-start",
          "atAnchor": "count-start-visible",
          "settleMs": 250
        }
      ]
    }
  ],
  "outcome": {
    "expected": "success"
  }
}
